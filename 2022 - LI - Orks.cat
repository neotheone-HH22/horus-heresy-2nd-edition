    <!-- Makari, Bana Wava (p136) - 40 pts -->
    <selectionEntry id="orks-dp10-0000-0001" name="Makari, Bana Wava" hidden="true" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="false">
          <conditions>
            <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="orks-dp09-0000-0001" type="atLeast"/>
          </conditions>
        </modifier>
      </modifiers>
      <categoryLinks>
        <categoryLink id="orks-dp10-0000-cl01" name="Unit:" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/>
      </categoryLinks>
      <rules>
        <rule id="orks-dp10-0000-r001" name="Da Boss&apos; Best Grot" page="136" hidden="false">
          <description>Makari may only be included in a Detachment that includes Ghazghkull Mag Uruk Thrakka, and does not take up a slot on the Force Organization Chart. He must form a unit with Ghazghkull at all times; Ghazghkull may still join and leave units, in which case Makari joins and leaves units with Ghazghkull as he does. If Ghazghkull is destroyed, then Makari may not leave any unit he had joined unless all other models in that unit are destroyed.</description>
        </rule>
        <rule id="orks-dp10-0000-r002" name="Suspicious Luck" page="136" hidden="false">
          <description>Makari has a 2+ invulnerable save.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="orks-dp10-0000-il01" name="Da Kolours (X)" hidden="false" targetId="orks-rule-kolo-0001" type="rule"/>
