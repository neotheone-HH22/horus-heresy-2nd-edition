          <modifiers>
            <modifier type="set" field="name" value="Furious Charge (1)"/>
          </modifiers>
        </infoLink>
        <infoLink id="orks-dp06-0000-il06" name="Independent Character" hidden="false" targetId="c57d-4820-458a-7ab5" type="rule"/>
        <infoLink id="orks-dp06-0000-il07" name="Hammer of Wrath (X)" hidden="false" targetId="aec0-c3aa-1e4e-1779" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Hammer of Wrath (1)"/>
          </modifiers>
        </infoLink>
        <infoLink id="orks-dp06-0000-il08" name="Monster Hunter" hidden="false" targetId="118d-58ce-8611-ab15" type="rule"/>
