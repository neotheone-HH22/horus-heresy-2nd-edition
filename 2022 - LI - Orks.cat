    <!-- Kaptin Badrukk (p127) - 180 pts -->
    <selectionEntry id="orks-dp02-0000-0001" name="Kaptin Badrukk" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="orks-dp02-0000-cl01" name="HQ:" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/>
        <categoryLink id="orks-dp02-0000-cl02" name="Unit:" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/>
      </categoryLinks>
      <rules>
        <rule id="orks-dp02-0000-r001" name="Warlord Trait: Da Kolour Hogger" page="127" hidden="false">
          <description>If Badrukk is an army&apos;s Warlord, he must have the following Warlord Trait:
Da Kolour Hogger: At the start of battle, the controlling player selects one additional Kolour for Badrukk, which applies to him and all models with the Flash of Kolours special rule in his unit. Similarly, whenever choosing new Kolours for the Flash of Kolours special rule, two Kolours may be chosen for Badrukk, with both new effects applying to him and all models with the Flash of Kolours special rule in his unit. If Badrukk is destroyed, his unit is immediately now only affected by the first chosen Kolour. In addition, an army with Badrukk as its Warlord gains an additional Reaction in the opposing player&apos;s Assault phase as long as he has not been removed as a casualty.</description>
        </rule>
        <rule id="orks-dp02-0000-r002" name="Goldtoof Armour" page="127" hidden="false">
          <description>The Goldtoof Armour confers a 3+ armour save and a 4+ invulnerable save.</description>
        </rule>
        <rule id="orks-dp02-0000-r003" name="Badrukk&apos;s Da Rippa" page="127" hidden="false">
          <description>Badrukk&apos;s Da Rippa is counted as a &apos;Plasma&apos; weapon for those rules that affect such weapons.</description>
        </rule>
      </rules>
      <infoLinks>
