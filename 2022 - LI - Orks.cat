    <!-- Mekboss Buzzgob (p132) - 140 pts -->
    <selectionEntry id="orks-dp07-0000-0001" name="Mekboss Buzzgob" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="orks-dp07-0000-cl01" name="HQ:" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/>
        <categoryLink id="orks-dp07-0000-cl02" name="Unit:" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/>
      </categoryLinks>
      <rules>
        <rule id="orks-dp07-0000-r001" name="Warlord Trait: The Brains Behind the Brawn" page="132" hidden="false">
          <description>If Buzzgob is an army&apos;s Warlord, he must have the following Warlord Trait:
The Brains Behind the Brawn: If any model other than Buzzgob in the controlling player&apos;s army has the Da Boss special rule, the controlling player may select one of them at the start of battle. That model gains a Warlord Trait as if it were the army&apos;s Warlord. If Buzzgob is destroyed, that model immediately loses that Warlord Trait. In addition, an army with Buzzgob as its Warlord gains an additional Reaction in the opposing player&apos;s Assault phase as long as he has not been removed as a casualty.</description>
        </rule>
        <rule id="orks-dp07-0000-r002" name="Mek Arms" page="132" hidden="false">
          <description>Each time Buzzgob fights, he makes two additional Attacks. Those attacks must be made using the Mek Arms.</description>
        </rule>
        <rule id="orks-dp07-0000-r003" name="Nitnuckle and Lunk" page="132" hidden="false">
          <description>Nitnuckle and Lunk can each be expended as an Ammo Runt, Distraction Grot, or Grot Oiler. Each can only be used once per battle.</description>
        </rule>
        <rule id="orks-dp07-0000-r004" name="Dreadheadz" page="132" hidden="false">
          <description>Buzzgob is counted as a Big Mek for the purpose of any Waaagh! Army which requires a Big Mek. Additionally, any unit entirely composed of models with the Dreadnought sub-Type in Buzzgob&apos;s army may be upgraded to have the Fear (1) special rule at a cost of +10 points per unit.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="orks-dp07-0000-il01" name="Da Kolours (X)" hidden="false" targetId="orks-rule-kolo-0001" type="rule"/>
        <infoLink id="orks-dp07-0000-il02" name="Black Is Ded &apos;Ard" hidden="false" targetId="orks-rule-kolo-blk0" type="rule"/>
        <infoLink id="orks-dp07-0000-il03" name="Battlesmith (X)" hidden="false" targetId="5d57-4d02-1e36-4a82" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Battlesmith (3+)"/>
          </modifiers>
        </infoLink>
        <infoLink id="orks-dp07-0000-il04" name="Da Boss" hidden="false" targetId="orks-rule-dbos-0001" type="rule"/>
        <infoLink id="orks-dp07-0000-il05" name="Independent Character" hidden="false" targetId="c57d-4820-458a-7ab5" type="rule"/>
