    <!-- Boss Snikrot (p128) - 180 pts -->
    <selectionEntry id="orks-dp03-0000-0001" name="Boss Snikrot" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="orks-dp03-0000-cl01" name="HQ:" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/>
        <categoryLink id="orks-dp03-0000-cl02" name="Unit:" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/>
      </categoryLinks>
      <rules>
        <rule id="orks-dp03-0000-r001" name="Warlord Trait: The Throat Slitter" page="128" hidden="false">
          <description>If Snikrot is an army&apos;s Warlord, he must have the following Warlord Trait:
The Throat Slitter: Snikrot is counted as a Warboss with the Snikboss upgrade for the purpose of any Waaagh! Army which requires a Snikboss. Snikrot, and all models in his unit, gain the Move Through Cover special rule, and the value of Snikrot&apos;s Fear (X) special rule is increased to Fear (2) during any turn in which his unit successfully completes a charge. In addition, an army with Snikrot as its Warlord gains an additional Reaction in the opposing player&apos;s Assault phase as long as he has not been removed as a casualty.</description>
        </rule>
        <rule id="orks-dp03-0000-r002" name="Sneakiest Git" page="128" hidden="false">
          <description>Snikrot has the Sneaky Gitz special rule. As long as he has joined a unit entirely composed of models with the Sneaky Gitz special rule, or has not joined a unit, his unit&apos;s Sneaky Gitz special rule applies even to models with the Primarch Unit Type and/or the Night Vision special rule.</description>
        </rule>
        <rule id="orks-dp03-0000-r003" name="Expert Infiltrator" page="128" hidden="false">
          <description>A model with this special rule has the Infiltrate special rule. Additionally, when a unit entirely composed of models with the Infiltrate special rule, and that includes at least one model with this special rule, arrives from reserves, that unit may be deployed on the battlefield using the provisions for the Infiltrate special rule. The unit may not charge during a turn in which it enters the battlefield this way.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="orks-dp03-0000-il01" name="Da Kolours (X)" hidden="false" targetId="orks-rule-kolo-0001" type="rule"/>
        <infoLink id="orks-dp03-0000-il02" name="Bulky (X)" hidden="false" targetId="676c-7b75-4b6f-9405" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Bulky (2)"/>
          </modifiers>
        </infoLink>
        <infoLink id="orks-dp03-0000-il03" name="Da Boss" hidden="false" targetId="orks-rule-dbos-0001" type="rule"/>
        <infoLink id="orks-dp03-0000-il04" name="Fear (X)" hidden="false" targetId="21f6-7842-df5c-d2e7" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Fear (1)"/>
