      </categoryLinks>
      <rules>
        <rule id="orks-hs01-0001-0001-r001" name="Even More Dakka!" page="53" hidden="false">
          <description>During the turn in which the controlling player declares a Waaagh!, each model with this special rule that makes a Shooting Attack with a weapon that has a random number of shots makes the maximum amount of shots possible without having to roll.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="orks-hs01-0001-0001-rl01" name="Da Kolours (X)" hidden="false" targetId="orks-rule-kolo-0001" type="rule" />
