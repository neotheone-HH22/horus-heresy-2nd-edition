          <profiles>
            <profile id="orks-wlt0-kunn-pr01" name="Kunnin' (but brutal)" hidden="false" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">This Warlord gains the Scouts Special Rule. In addition, for every full 1000 points in the army, the Controlling Player may select one unit with the Troops Force Organisation slot that also gains the Scouts and Outflank Special Rules. These units must be nominated before deployment begins. In addition, an army whose Warlord has this Trait may make an additional Reaction during the opposing player's Assault phase so long as the Warlord has not been removed as a casualty.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
        </selectionEntry>
