        <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">4</characteristic>
        <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Heavy D3, Blast (3&quot;), Breaching (5+), Pinning</characteristic>
      </characteristics>
    </profile>
    <profile id="orks-wpn0-0003-0001" name="Burna (ranged)" page="109" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
