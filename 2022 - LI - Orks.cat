          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="orks-wlt0-best-c1" type="max"/>
            <constraint field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="orks-wlt0-best-c2" type="max"/>
          </constraints>
          <profiles>
            <profile id="orks-wlt0-best-pr01" name="Best of the Beasts" hidden="false" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">This Warlord gains the Battle-Hardened (1) Special Rule. In addition, the Controlling Player may select one unit of Nobz, Meganobz, or Nob Bikerz in the army. That unit gains the Skarboyz upgrade at no additional cost. In addition, an army whose Warlord has this Trait may make an additional Reaction during the opposing player's Assault phase so long as the Warlord has not been removed as a casualty.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
