        <rule id="orks-ft01-0003-0001-r01" name="Mek Werkshop" page="89" hidden="false">
          <description>At the start of each of your turns, one friendly Vehicle within 6&quot; of this model may recover 1 lost Hull Point. This may not be used on a model that has suffered an Explodes! result.</description>
        </rule>
