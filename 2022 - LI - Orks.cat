    <!-- 'Mad Dok' Grotsnik (p129) - 160 pts -->
    <selectionEntry id="orks-dp04-0000-0001" name="&apos;Mad Dok&apos; Grotsnik" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="orks-dp04-0000-cl01" name="HQ:" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/>
        <categoryLink id="orks-dp04-0000-cl02" name="Unit:" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/>
      </categoryLinks>
      <rules>
        <rule id="orks-dp04-0000-r001" name="One Scalpel Short of a Medpack" page="129" hidden="false">
          <description>Grotsnik may not be an army&apos;s Warlord. He may not join a unit that has already been joined by a model upgraded to be a Painboss, or has had a Painboy assigned to it using the Painboyz Workshop special rule.
Once Grotsnik has joined a unit, he may not willingly leave that unit unless there are no other models remaining. All Infantry models (excluding models with the Artillery sub-Type) in any unit Grotsnik joins gain the Fearless and Rampage (1) special rules so long as he is part of that unit.</description>
        </rule>
        <rule id="orks-dp04-0000-r002" name="Ghazghkull&apos;s Own Painboy" page="129" hidden="false">
          <description>While Grotsnik has joined the same unit as Ghazghkull Mag Uruk Thrakka, the value of Ghazghkull&apos;s It Will Not Die special rule is improved to It Will Not Die (2+).</description>
        </rule>
        <rule id="orks-dp04-0000-r003" name="Kombi-Flinga" page="129" hidden="false">
          <description>Each time Grotsnik makes a Shooting Attack, both profiles of the Kombi-flinga may be fired as one weapon.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="orks-dp04-0000-il01" name="Da Kolours (X)" hidden="false" targetId="orks-rule-kolo-0001" type="rule"/>
        <infoLink id="orks-dp04-0000-il02" name="Black Is Ded &apos;Ard" hidden="false" targetId="orks-rule-kolo-blk0" type="rule"/>
