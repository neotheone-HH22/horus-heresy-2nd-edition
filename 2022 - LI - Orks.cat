    <!-- Mozrog Skragbad (p131) - 240 pts -->
    <selectionEntry id="orks-dp06-0000-0001" name="Mozrog Skragbad" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="orks-dp06-0000-cl01" name="HQ:" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/>
        <categoryLink id="orks-dp06-0000-cl02" name="Unit:" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/>
      </categoryLinks>
      <rules>
        <rule id="orks-dp06-0000-r001" name="Warlord Trait: Surlier than a Squiggoth" page="131" hidden="false">
          <description>If Mozrog is an army&apos;s Warlord, he must have the following Warlord Trait:
Surlier than a Squiggoth: Mozrog is counted as a Warboss with the Wildboss upgrade for the purpose of any Waaagh! Army which requires a Wildboss. The first time Mozrog would be destroyed because he was reduced to 0 Wounds, he remains on the battlefield at 0 Wounds instead - he acts normally, but Wounds cannot be further allocated to him for the remainder of the current phase. At the end of the current phase, he regains D3 Wounds. In addition, an army with Mozrog as its Warlord gains an additional Reaction in the opposing player&apos;s Movement phase as long as he has not been removed as a casualty.</description>
        </rule>
        <rule id="orks-dp06-0000-r002" name="Harder than Rock" page="131" hidden="false">
          <description>Mozrog may take Feel No Pain damage mitigation rolls against Wounds with the Instant Death special rule.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="orks-dp06-0000-il01" name="Da Kolours (X)" hidden="false" targetId="orks-rule-kolo-0001" type="rule"/>
        <infoLink id="orks-dp06-0000-il02" name="White Means Deff" hidden="false" targetId="orks-rule-kolo-wht0" type="rule"/>
