        <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Melee, Two-Handed, Force</characteristic>
      </characteristics>
    </profile>
    <profile id="orks-wpn0-0129-0001" name="Deff Rolla" page="117" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="95ba-cda7-b831-6066">-</characteristic>
        <characteristic name="Strength" typeId="24d9-b8e1-a355-2458">12</characteristic>
