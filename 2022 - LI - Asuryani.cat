        <characteristic name="Type" typeId="2076-1693-8674-f032">Ordnance 1, Murderous Strike (5+), Barrage, Blast (3&amp;quot;)</characteristic>
      </characteristics>
    </profile>
    <profile id="e9db-469d-6bac-78c0" name="D-Impaler" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="2215-aa21-e3ff-e0a1">36"</characteristic>
        <characteristic name="Str" typeId="8935-13e5-2612-d283">10</characteristic>
        <characteristic name="AP" typeId="ecf0-eee8-0b48-ce79">1</characteristic>
        <characteristic name="Type" typeId="2076-1693-8674-f032">Destroyer 1, Large Blast (5&amp;quot;), Instant Death, Distortion Impalement</characteristic>
      </characteristics>
    </profile>
    <profile id="dad9-922a-0bbf-0608" name="D-Scythe" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="2215-aa21-e3ff-e0a1">Template</characteristic>
        <characteristic name="Str" typeId="8935-13e5-2612-d283">7</characteristic>
        <characteristic name="AP" typeId="ecf0-eee8-0b48-ce79">2</characteristic>
        <characteristic name="Type" typeId="2076-1693-8674-f032">Heavy 1, Murderous Strike (5+)</characteristic>
      </characteristics>
    </profile>
    <profile id="8415-2bcc-f2a5-4ab3" name="Heavy Wraithcannon" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="2215-aa21-e3ff-e0a1">36"</characteristic>
        <characteristic name="Str" typeId="8935-13e5-2612-d283">10</characteristic>
        <characteristic name="AP" typeId="ecf0-eee8-0b48-ce79">2</characteristic>
        <characteristic name="Type" typeId="2076-1693-8674-f032">Ordnance 1, Murderous Strike (5+), Blast (3&amp;quot;)</characteristic>
      </characteristics>
    </profile>
    <profile id="ba8b-1ad9-003d-5f63" name="Wraithcannon" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="2215-aa21-e3ff-e0a1">18"</characteristic>
        <characteristic name="Str" typeId="8935-13e5-2612-d283">8</characteristic>
        <characteristic name="AP" typeId="ecf0-eee8-0b48-ce79">2</characteristic>
        <characteristic name="Type" typeId="2076-1693-8674-f032">Ordnance 1, Murderous Strike (5+)</characteristic>
      </characteristics>
    </profile>
    <profile id="8f1d-de4d-2b34-cae8" name="Bright Lance" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="2215-aa21-e3ff-e0a1">36"</characteristic>
        <characteristic name="Str" typeId="8935-13e5-2612-d283">8</characteristic>
        <characteristic name="AP" typeId="ecf0-eee8-0b48-ce79">2</characteristic>
        <characteristic name="Type" typeId="2076-1693-8674-f032">Heavy 1, Lance, Sunder</characteristic>
      </characteristics>
    </profile>
    <profile id="ae67-0939-a6c2-f4a7" name="Gravis Bright Lance" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="2215-aa21-e3ff-e0a1">36"</characteristic>
        <characteristic name="Str" typeId="8935-13e5-2612-d283">8</characteristic>
        <characteristic name="AP" typeId="ecf0-eee8-0b48-ce79">2</characteristic>
        <characteristic name="Type" typeId="2076-1693-8674-f032">Heavy 2, Lance, Sunder</characteristic>
      </characteristics>
    </profile>
    <profile id="066f-f26f-3ad1-4beb" name="Firestorm Scatter Array" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="2215-aa21-e3ff-e0a1">36"</characteristic>
        <characteristic name="Str" typeId="8935-13e5-2612-d283">6</characteristic>
        <characteristic name="AP" typeId="ecf0-eee8-0b48-ce79">6</characteristic>
        <characteristic name="Type" typeId="2076-1693-8674-f032">Heavy 12, Pinning, Twin-Linked</characteristic>
      </characteristics>
    </profile>
