  <entryLinks>
    <entryLink id="e1da-asur-yani-el01" name="Asuryani" hidden="false" collective="false" import="false" targetId="e1da-asur-yani-gst1" type="selectionEntry">
      <modifiers>
        <modifier type="add" field="category" value="7b69-bf2f-4547-e83b">
          <conditions>
