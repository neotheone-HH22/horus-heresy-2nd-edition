        <characteristic name="AP" typeId="ecf0-eee8-0b48-ce79">1</characteristic>
        <characteristic name="Type" typeId="2076-1693-8674-f032">Destroyer 1, Apocalyptic Mega-Blast, Instant Death, Distortion Impalement</characteristic>
      </characteristics>
    </profile>
